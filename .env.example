# GridStorm environment template. Copy to .env (never commit real values).

# --- API (services/api) ---
# Postgres connection (Supabase: Project Settings → Database → connection string, use the pooler URL
# with sslmode=require). Leave empty to use local SQLite (development only).
DATABASE_URL=
GRIDSTORM_DATA_DIR=./data
GRIDSTORM_ARTIFACT_DIR=./var/artifacts
GRIDSTORM_CORS_ORIGINS=http://localhost:5173
GRIDSTORM_EXECUTION_MODE=live            # live | precomputed
GRIDSTORM_MAX_CONCURRENT_JOBS=1
GRIDSTORM_JOB_TIMEOUT_S=180
GRIDSTORM_JOB_MEMORY_MB=450

# Supabase auth (JWT verification). Service-role key is server-side only and optional.
SUPABASE_URL=
SUPABASE_JWT_SECRET=

# S3-compatible artifact storage (Cloudflare R2). Leave empty to use local storage.
S3_ENDPOINT_URL=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Web (apps/web) ---
VITE_API_BASE_URL=http://localhost:8000
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

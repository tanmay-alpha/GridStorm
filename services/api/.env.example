# uvicorn does not read this file automatically. Copy to .env.local and export it,
# or use: uv run --env-file .env.local uvicorn gridstorm_api.main:app --port 8000
# Empty values select the defaults; never commit actual credentials.
DATABASE_URL=
GRIDSTORM_STATE_DIR=
GRIDSTORM_DATA_DIR=
GRIDSTORM_PRESETS_DIR=
GRIDSTORM_CORS_ORIGINS=http://localhost:5173
# Comma-separated allow-list; an explicitly empty value disables all live networks.
GRIDSTORM_LIVE_NETWORKS=ac-dc-meshed,pglib-case14-ieee,pglib-case118-ieee,pypsa-eur-be
GRIDSTORM_EXECUTION_MODE=live
GRIDSTORM_RUN_WORKERS=true
GRIDSTORM_MAX_CONCURRENT_JOBS=1
GRIDSTORM_ENGINE_CMD=
GRIDSTORM_JOB_TIMEOUT_S=180
GRIDSTORM_JOB_MEMORY_MB=400
GRIDSTORM_JOB_MAX_ATTEMPTS=2
GRIDSTORM_JOB_STALE_AFTER_S=60
GRIDSTORM_MAX_QUEUED_JOBS=50
GRIDSTORM_MAX_BODY_BYTES=262144
GRIDSTORM_RATE_LIMIT_POST_PER_MIN=60
GRIDSTORM_RATE_LIMIT_POST_BURST=20
GRIDSTORM_RATE_LIMIT_SIM_PER_MIN=6
GRIDSTORM_RATE_LIMIT_SIM_BURST=3
GRIDSTORM_TRUST_PROXY=false
GRIDSTORM_DB_AUTO_MIGRATE=false
GRIDSTORM_MIGRATIONS_DIR=
# Only for plain local Postgres, NEVER for Supabase:
GRIDSTORM_DB_SUPABASE_STUB=false
GRIDSTORM_ARTIFACT_STORE=local
GRIDSTORM_ARTIFACT_DIR=
GRIDSTORM_S3_BUCKET=
GRIDSTORM_S3_ENDPOINT_URL=
GRIDSTORM_S3_REGION=
GRIDSTORM_S3_PREFIX=
# S3 also uses boto3's standard AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY chain.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
GRIDSTORM_GIT_SHA=
